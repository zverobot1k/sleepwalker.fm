# Copy to .env and fill in values (never commit .env)

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Public URL of the backend API (ngrok tunnel to port 8080). Required.
BASE_URL=https://your-subdomain.ngrok-free.dev
# URL where the Next.js app is served (NOT the ngrok API host unless frontend is tunneled too).
FRONTEND_URL=http://localhost:3000
# Must match backend route GET /auth/spotify/callback exactly.
SPOTIFY_REDIRECT_URI=https://your-subdomain.ngrok-free.dev/auth/spotify/callback

DATABASE_URL=postgres://postgres:postgres@db:5432/sleepwalker?sslmode=disable

LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
